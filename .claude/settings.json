{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git reset --hard *)",
      "Bash(gh *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh *)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-ChildItem env:*)"
    ]
  }
}