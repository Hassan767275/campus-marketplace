PORT=4000

# Supabase > Connect > Direct > Session pooler 
DATABASE_URL=

# developer.paypal.com > Apps & Credentials > Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CORS_ORIGINS=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# School email domains allowed to sign up (comma-separated). Subdomains are allowed too.
ALLOWED_EMAIL_DOMAINS=

# Public URL of this API, used in email verification links. Defaults to http://localhost:PORT.
API_PUBLIC_URL=

# Supabase Storage for listing photos. Project Settings > API (URL), API Keys > secret / service_role key.
# Server only: the service role key bypasses all security. Never put it in client/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for listing photos. Create it once with: npm run storage:setup -w server
SUPABASE_STORAGE_BUCKET=listing-photos
